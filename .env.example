# 青云盾加密宝 Environment Variables Template
# Copy this file to .env and modify the values

# Application Configuration
# 添加VITE_前缀使环境变量在客户端可访问
VITE_APP_TITLE=青云盾加密宝
VITE_APP_DESCRIPTION="安全的文本加密分享工具"

# Admin Configuration
# 设置管理员密码，使用此密码加密的内容将永不过期
# 请将此值替换为强密码，并妥善保管
# 注意：必须修改为您自己的密码才能生效
VITE_ADMIN_PASSWORD=your-admin-password
