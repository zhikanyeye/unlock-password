# 青云盾加密宝 Environment Variables

# Encryption Configuration
# 加密密钥是在每次加密时随机生成的，不需要在此配置

# Application Configuration
APP_TITLE=青云盾加密宝
APP_DESCRIPTION="安全的文本加密分享工具"

# Storage Configuration
USE_REMOTE_STORAGE=true

# Admin Configuration
# 设置管理员密码，使用此密码加密的内容将永不过期
# 请将此值替换为强密码，并妥善保管
ADMIN_PASSWORD=your-admin-password